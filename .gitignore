# Rust
.tmp/
backend/target/
**/*.rs.bk

# Node
node_modules/
dist/
.cache/
.local-dev/
*.tsbuildinfo

# Python helper outputs
__pycache__/
*.py[cod]

# Swift / Gradle build outputs
**/.build/
**/.swiftpm/
**/.kotlin/

# OMC/session state — anywhere in the tree (planning artifacts in .omc/plans, .omc/specs, .omc/ultragoal ARE tracked)
**/.omc/state/
**/.omc/logs/
**/.omc/notepad.md

# OS / editor
.DS_Store
*.swp

# Env & secrets
.env
.env.*
!.env.example
**/.omc/sessions/
**/.omc/project-memory.json
.claude/worktrees/
ops/.dev-secrets/

# Linked git worktrees (77+ lane worktrees — gitlinks must never be committed)
/.worktrees/
# Local agent/session tooling (not project source)
/.omx/
.omc/handoffs/
.omc/*.tmp.*
.omc/.project-memory.json.tmp.*
.hermes/
.agents/
.claude/skills/
skills-lock.json

# Talos generated custody artifacts
_talos/
_talos-*/
deploy/talos/_out/
deploy/talos/**/secrets.yaml
deploy/talos/**/talosconfig
*.kubeconfig

# Buck2 local outputs and host-specific linker configuration.
/buck-out/
**/buck-out/
.buckconfig.local

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Grok runtime board (materialized by tools/ci/ingest-soft-reds.mjs; not custodied)
ci/harness/lane-board.live.json

# Agent working directories must never be committed. Load-bearing content is
# drained to a real home first (see PLAN.md 39); these hold scratch only.
.grok/
.claude/
.codex/
.cursor/
.agents/
.beads/
.omx/
.omc/

# rustc's default output name when compiling from stdin (`rustc - <<EOF`).
# A 463 KB Mach-O binary reached a PR that way and no gate caught it; Repo
# gates was green on the SHA that carried it.
rust_out
